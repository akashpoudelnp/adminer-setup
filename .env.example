# Copy this file to .env and adjust for your machine.
# .env is gitignored - never commit real credentials.

# Adminer version to download ("latest" or e.g. 6.0.0)
ADMINER_VERSION=latest

# Default login - prefilled into the Adminer login form.
# DB_PORT is appended to DB_HOST as host:port.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=

# Plugins - set to true/false
PLUGIN_PASSWORDLESS=false
PLUGIN_JSON_PREVIEW=true
PLUGIN_DUMP_JSON=true

# Password accepted by the passwordless plugin.
# Empty string = login with an empty password (previous behaviour).
PASSWORDLESS_PASSWORD=
